# ============================================================
# Project-specific runtime artifacts
# ============================================================

# Logs
logs/
*.log
*.log.*
!logs/.gitkeep

# Ingestion spill files
ingest_spill/
ingest_spill/*
!ingest_spill/.gitkeep

# Archive backfill (large binary data)
# Comment these out if you want to commit the source Excel/Parquet.
archive/backfill/*
!archive/backfill/.gitkeep

# Certificate files (MQTT TLS)
*.crt
*.key
*.pem
*.p12
*.pfx
certs/
server/certs/

