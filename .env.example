# Database (two roles — see architecture notes)
DATABASE_URL_WRITER=postgresql+psycopg://iiot_writer:change_me@localhost:5432/iiot_dashboard
DATABASE_URL_READER=postgresql+psycopg://iiot_reader:change_me@localhost:5432/iiot_dashboard

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_TEMPLATE=factory/{line_id}/telemetry
MQTT_QOS=1

# Timing
SOURCE_WINDOW_MINUTES=10
DASHBOARD_RENDER_INTERVAL_S=5
PLANT_TZ=Asia/Kolkata

# Server
API_HOST=127.0.0.1
API_PORT=8000
WS_HEARTBEAT_S=30