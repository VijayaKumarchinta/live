DATABASE_URL_WRITER=postgresql+psycopg://iiot_writer:change_me@localhost:5432/iiot_dashboard
DATABASE_URL_READER=postgresql+psycopg://iiot_reader:change_me@localhost:5432/iiot_dashboard

DB_CONNECT_TIMEOUT=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
MQTT_TOPIC_TEMPLATE=factory/{line_id}/telemetry
MQTT_QOS=1

SOURCE_WINDOW_MINUTES=10
DASHBOARD_RENDER_INTERVAL_S=5
PLANT_TZ=Asia/Kolkata
CUTOVER_TS=2026-11-01T00:00:00+05:30
RETENTION_MONTHS=12

API_HOST=127.0.0.1
API_PORT=8000
FLASK_DEBUG=1
FLASK_SECRET_KEY=replace_with_random_hex
CORS_ORIGINS=http://localhost:5173

WS_HEARTBEAT_S=30
WS_CLIENT_QUEUE_MAX=1000
INGEST_QUEUE_MAX=10000

ARCHIVE_DIR=./archive/backfill
SPILL_DIR=./ingest_spill
LOG_DIR=./logs
LOG_LEVEL=INFO
